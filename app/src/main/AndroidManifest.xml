<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Necessária apenas para a sincronização do chat e das dúvidas.
         Os dados clínicos nunca saem do aparelho. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        A partir do Android 11, uma aplicação não consegue ver que outras estão
        instaladas sem o declarar aqui. Sem este bloco, resolveActivity() devolve
        null para o marcador telefónico mesmo quando ele existe, e a app conclui
        erradamente que o aparelho não faz chamadas.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
    </queries>

    <application
        android:name=".VitalApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Vital">

        <activity
            android:name=".EntradaActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name=".CaixaRemediosActivity" android:exported="false" />
        <activity android:name=".AdicionarRemedioActivity" android:exported="false" />
        <activity android:name=".AlertaAlarmeActivity" android:exported="false" />
        <activity android:name=".EmergenciaActivity" android:exported="false" />
        <activity android:name=".ComunidadeActivity" android:exported="false" />
        <activity android:name=".HistorialActivity" android:exported="false" />
        <activity android:name=".ConsultasActivity" android:exported="false" />
        <activity android:name=".MarcarConsultaActivity" android:exported="false" />
        <activity android:name=".ChatFamiliaActivity" android:exported="false" />
        <activity android:name=".DuvidasActivity" android:exported="false" />
    </application>

</manifest>