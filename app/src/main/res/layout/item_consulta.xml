<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardItemConsulta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/vital_gray"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Etiqueta opcional (ex: PASSADA — o Adapter mostra/esconde conforme a data) -->
        <TextView
            android:id="@+id/tvConsultaEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:letterSpacing="0.05"
            android:text="PASSADA"
            android:textColor="@color/vital_gray"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Data e Hora -->
        <TextView
            android:id="@+id/tvConsultaDataHora"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ter, 8 dez · 15:00"
            android:textColor="@color/vital_navy"
            android:textSize="19sp"
            android:textStyle="bold" />

        <!-- Especialidade / Tipo -->
        <TextView
            android:id="@+id/tvConsultaTipo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Análises ao sangue"
            android:textColor="@color/vital_navy"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Acompanhante ou Notas -->
        <TextView
            android:id="@+id/tvConsultaDetalhe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Acompanha: ainda por definir"
            android:textColor="@color/vital_gray"
            android:textSize="15sp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>