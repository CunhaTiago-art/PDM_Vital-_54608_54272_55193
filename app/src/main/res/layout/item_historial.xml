<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal"
        android:paddingVertical="12dp">

        <!-- Data e Hora (Esquerda) -->
        <TextView
            android:id="@+id/tvHistDataHora"
            android:layout_width="76dp"
            android:layout_height="wrap_content"
            android:text="Hoje\n08:00"
            android:textColor="@color/vital_navy"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Título e Detalhe (Direita) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHistTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ramipril 5 mg"
                android:textColor="@color/vital_navy"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHistDetalhe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="✓ Tomado · registado pelo idoso"
                android:textColor="@color/vital_green"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Linha divisória fina -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/vital_divider" />

</LinearLayout>