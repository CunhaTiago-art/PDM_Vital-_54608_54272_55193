<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="@dimen/margin_standard">

    <!-- Botão Voltar -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVoltarConsultas"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="72dp"
        android:minWidth="168dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:gravity="start|center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="24dp"
        android:text="‹  Voltar"
        android:textAllCaps="false"
        android:textColor="@color/vital_navy"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Título -->
    <TextView
        android:id="@+id/tvTituloConsultas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Consultas"
        android:textColor="@color/vital_navy"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnVoltarConsultas" />

    <!-- Cartão de Destaque: PRÓXIMA CONSULTA -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardProximaConsulta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/vital_green"
        app:strokeWidth="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTituloConsultas">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.05"
                android:text="PRÓXIMA CONSULTA"
                android:textColor="@color/vital_green"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProxConsultaDataHora"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Sex, 27 nov · 10:30"
                android:textColor="@color/vital_navy"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProxConsultaEspecialidade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Cardiologia"
                android:textColor="@color/vital_navy"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProxConsultaMedicoLocal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="[Nome do médico] · [Local]"
                android:textColor="@color/vital_gray"
                android:textSize="16sp" />

            <!-- Linha: Acompanha -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="Acompanhante"
                    android:src="@drawable/ic_person"
                    app:tint="@color/vital_navy" />

                <TextView
                    android:id="@+id/tvProxConsultaAcompanhante"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Acompanha: Filha"
                    android:textColor="@color/vital_navy"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Secção: Mais tarde -->
    <TextView
        android:id="@+id/tvTituloMaisTarde"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Mais tarde"
        android:textColor="@color/vital_navy"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardProximaConsulta" />

    <!-- Lista de Outras Consultas -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvConsultas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="16dp"
        tools:listitem="@layout/item_consulta"
        app:layout_constraintBottom_toTopOf="@+id/btnMarcarConsulta"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTituloMaisTarde" />

    <!-- Botão Fixo em Baixo: + Marcar consulta -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMarcarConsulta"
        android:layout_width="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/vital_green"
        android:minHeight="68dp"
        android:text="+  Marcar consulta"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        app:cornerRadius="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>