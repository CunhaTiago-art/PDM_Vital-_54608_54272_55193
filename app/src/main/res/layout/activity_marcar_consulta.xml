<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="@dimen/margin_standard">

    <ScrollView
        android:id="@+id/scrollMarcarConsulta"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="16dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/btnGuardarConsulta"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Botão Voltar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVoltarMarcarConsulta"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:paddingStart="0dp"
                android:text="‹  Voltar"
                android:textAllCaps="false"
                android:textColor="@color/vital_navy"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Título -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Marcar consulta"
                android:textColor="@color/vital_navy"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- Especialidade ou motivo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Especialidade ou motivo"
                android:textColor="@color/vital_navy"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEspecialidade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_outline"
                android:hint="Ex.: Cardiologia"
                android:inputType="textCapSentences"
                android:minHeight="54dp"
                android:paddingHorizontal="16dp"
                android:textColor="@color/vital_navy"
                android:textColorHint="@color/vital_gray"
                android:textSize="18sp" />

            <!-- Data e Hora lado a lado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <!-- Coluna Data -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1.5"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Data"
                        android:textColor="@color/vital_navy"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etDataConsulta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_outline"
                        android:clickable="true"
                        android:focusable="false"
                        android:hint="27/11/2026"
                        android:minHeight="54dp"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/vital_navy"
                        android:textColorHint="@color/vital_gray"
                        android:textSize="18sp" />
                </LinearLayout>

                <!-- Coluna Hora -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hora"
                        android:textColor="@color/vital_navy"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etHoraConsulta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_outline"
                        android:clickable="true"
                        android:focusable="false"
                        android:hint="10:30"
                        android:minHeight="54dp"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/vital_navy"
                        android:textColorHint="@color/vital_gray"
                        android:textSize="18sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Local -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Local"
                android:textColor="@color/vital_navy"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etLocalConsulta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_outline"
                android:hint="Centro de saúde, hospital..."
                android:inputType="textCapSentences"
                android:minHeight="54dp"
                android:paddingHorizontal="16dp"
                android:textColor="@color/vital_navy"
                android:textColorHint="@color/vital_gray"
                android:textSize="18sp" />

            <!-- Quem acompanha? -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Quem acompanha?"
                android:textColor="@color/vital_navy"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAcompFilha"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_marginEnd="10dp"
                    android:backgroundTint="@color/vital_green"
                    android:paddingHorizontal="18dp"
                    android:text="✓  Filha"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAcompNeto"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:paddingHorizontal="20dp"
                    android:text="Neto"
                    android:textAllCaps="false"
                    android:textColor="@color/vital_navy"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/vital_navy"
                    app:strokeWidth="2dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAcompEnfermeiro"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:paddingHorizontal="20dp"
                android:text="Enfermeiro"
                android:textAllCaps="false"
                android:textColor="@color/vital_navy"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:strokeColor="@color/vital_navy"
                app:strokeWidth="2dp" />

            <!-- Lembrete -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Lembrete"
                android:textColor="@color/vital_navy"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLembrete1Hora"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="4dp"
                    android:text="1 hora"
                    android:textAllCaps="false"
                    android:textColor="@color/vital_navy"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/vital_navy"
                    app:strokeWidth="2dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLembrete1Dia"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/vital_green"
                    android:paddingHorizontal="4dp"
                    android:text="✓ 1 dia"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLembrete1Semana"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="4dp"
                    android:text="1 semana"
                    android:textAllCaps="false"
                    android:textColor="@color/vital_navy"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/vital_navy"
                    app:strokeWidth="2dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Botão Fixo em Baixo: ✓ GUARDAR E AVISAR TODOS -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGuardarConsulta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/vital_green"
        android:gravity="center"
        android:minHeight="72dp"
        android:text="✓  GUARDAR E AVISAR\nTODOS"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:cornerRadius="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>