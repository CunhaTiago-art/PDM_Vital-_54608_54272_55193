<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vital_green"
    android:padding="@dimen/margin_large">

    <!-- Cabeçalho: Sino + HORA DA MEDICAÇÃO -->
    <LinearLayout
        android:id="@+id/layoutHeaderAlerta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="Alarme"
            android:src="@drawable/ic_bell"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tvTituloAlerta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.05"
            android:text="HORA DA MEDICAÇÃO"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Hora em tamanho gigante -->
    <TextView
        android:id="@+id/tvAlertaHora"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="14:00"
        android:textColor="@color/white"
        android:textSize="64sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutHeaderAlerta" />

    <!-- Caixa: foto do medicamento -->
    <TextView
        android:id="@+id/tvFotoMedicamentoAlerta"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_foto_placeholder_white"
        android:gravity="center"
        android:padding="16dp"
        android:text="foto do\nmedicamento"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvAlertaHora" />

    <!-- Nome do Medicamento -->
    <TextView
        android:id="@+id/tvAlertaNomeMed"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="Metformina 500\nmg"
        android:textColor="@color/white"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvFotoMedicamentoAlerta" />

    <!-- Dosagem e Instrução -->
    <TextView
        android:id="@+id/tvAlertaDoseMed"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="1 comprimido · com o almoço"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvAlertaNomeMed" />

    <!-- Botão Principal: ✓ JÁ TOMEI (Branco com texto verde) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmarToma"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="@color/white"
        android:text="✓  JÁ TOMEI"
        android:textColor="@color/vital_green"
        android:textSize="24sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toTopOf="@+id/btnAdiarToma"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Botão Secundário: ADIAR 10 MINUTOS (Contorno branco) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAdiarToma"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:text="ADIAR 10 MINUTOS"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:strokeColor="@color/white"
        app:strokeWidth="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>