<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/action_primary_blue"
    android:padding="@dimen/margin_large">

    <!-- Cabeçalho de Alerta -->
    <TextView
        android:id="@+id/tvTituloAlerta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="HORA DO MEDICAMENTO!"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_title"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Cartão Central com Detalhes da Toma -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardDetalheAlerta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/margin_large"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/corner_radius"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toTopOf="@+id/btnConfirmarToma"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTituloAlerta">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/margin_large">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_medication"
                app:tint="@color/action_primary_blue"
                android:contentDescription="Ícone de comprimido" />

            <TextView
                android:id="@+id/tvAlertaHora"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="14:30"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_hero"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAlertaNomeMed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Ben-u-ron"
                android:textAlignment="center"
                android:textColor="@color/action_primary_blue"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAlertaDoseMed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tomar 1 comprimido (1000mg)"
                android:textAlignment="center"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_normal" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Botão Gigante: Confirmar Toma -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmarToma"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_marginBottom="@dimen/margin_standard"
        android:backgroundTint="@color/action_success_green"
        android:text="JÁ TOMEI"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_title"
        android:textStyle="bold"
        app:cornerRadius="@dimen/corner_radius"
        app:layout_constraintBottom_toTopOf="@+id/btnAdiarToma"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Botão Secundário: Adiar 10 minutos -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAdiarToma"
        android:layout_width="0dp"
        android:layout_height="@dimen/min_touch_target_height"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/white"
        android:text="Lembrar daqui a 10 min"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_size_normal"
        android:textStyle="bold"
        app:cornerRadius="@dimen/corner_radius"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>