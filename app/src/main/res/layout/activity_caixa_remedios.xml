<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="@dimen/margin_standard">

    <!-- Botão Voltar (sem borda) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVoltarCaixa"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="72dp"
        android:minWidth="168dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:gravity="start|center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="24dp"
        android:text="‹  Voltar"
        android:textAllCaps="false"
        android:textColor="@color/vital_navy"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Título -->
    <TextView
        android:id="@+id/tvTituloCaixa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Caixa de Remédios"
        android:textColor="@color/vital_navy"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnVoltarCaixa" />

    <!-- Lista de Prescrições (RecyclerView + Room) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMedicamentos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        tools:listitem="@layout/item_medicamento"
        app:layout_constraintBottom_toTopOf="@+id/btnAdicionarMed"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTituloCaixa" />

    <!-- Botão Fixo em Baixo: + Adicionar medicamento -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAdicionarMed"
        android:layout_width="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/vital_green"
        android:gravity="start|center_vertical"
        android:minHeight="72dp"
        android:paddingHorizontal="20dp"
        android:text="+   Adicionar\n     medicamento"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        app:cornerRadius="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>