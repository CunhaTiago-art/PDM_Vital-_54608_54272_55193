<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/vital_gray"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Pergunta -->
        <TextView
            android:id="@+id/tvPerguntaTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="O alarme não tocou. O que faço?"
            android:textColor="@color/vital_navy"
            android:textSize="19sp"
            android:textStyle="bold" />

        <!-- Estado / Número de Respostas -->
        <TextView
            android:id="@+id/tvPerguntaEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="✓ Resolvido · 3 respostas"
            android:textColor="@color/vital_green"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>