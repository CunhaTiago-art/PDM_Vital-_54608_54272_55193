<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/vital_gray"
    app:strokeWidth="1.5dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Caixa de Foto -->
        <TextView
            android:id="@+id/tvFotoPlaceholder"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/bg_foto_placeholder"
            android:gravity="center"
            android:text="foto"
            android:textColor="@color/vital_gray"
            android:textSize="15sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Nome, Dosagem e Hora -->
        <LinearLayout
            android:id="@+id/layoutInfoMed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvSetaDetalhe"
            app:layout_constraintStart_toEndOf="@+id/tvFotoPlaceholder"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvItemNomeMed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ramipril 5 mg"
                android:textColor="@color/vital_navy"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvItemDoseMed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="1 comprimido"
                android:textColor="@color/vital_gray"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tvItemHoraMed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="08:00"
                android:textColor="@color/vital_navy"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Seta de Detalhe -->
        <TextView
            android:id="@+id/tvSetaDetalhe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="@color/vital_navy"
            android:textSize="36sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>